+# [repro patch] Driver for the benchmark reproduction of Table I (Gaussian IC).
+# Uses the official functions (df.train / df.test / wf.generate_Gaussian / wf.perf_eval);
+# only adds seeding, data caching, CLI arguments and a CSV row per run.
+#
+#   python repro.py --mode pretrained --K 10 --test_seed 7
+#   python repro.py --mode train --K 10 --seed 0 --num_train 1000000 --epochs 100
+import argparse, csv, os, time
+import numpy as np
+import scipy.io as sio
+import function_wmmse_powercontrol as wf
+import function_dnn_powercontrol as df
+
+p = argparse.ArgumentParser()
+p.add_argument('--mode', choices=['pretrained', 'train'], required=True)
+p.add_argument('--K', type=int, default=10)
+p.add_argument('--seed', type=int, default=0, help='TF/numpy seed for weight init and minibatch sampling')
+p.add_argument('--train_seed', type=int, default=0, help='seed of the training-set channels (demo.py uses 0)')
+p.add_argument('--test_seed', type=int, default=7, help='seed of the test-set channels (test.py uses 7)')
+p.add_argument('--num_train', type=int, default=1000000, help='paper: 1e6 training samples')
+p.add_argument('--num_test', type=int, default=10000, help='paper: 1e4 test samples')
+p.add_argument('--epochs', type=int, default=100)
+p.add_argument('--batch', type=int, default=1000, help='paper: 1000')
+p.add_argument('--lr', type=float, default=0.001, help='paper: 0.001')
+p.add_argument('--val_split', type=float, default=0.01)
+p.add_argument('--hidden', type=int, nargs=3, default=[200, 80, 80], help='official code/checkpoints: 200 80 80; paper text: 200 200 200')
+p.add_argument('--out', default='runs')
+p.add_argument('--csv', default='results.csv')
+a = p.parse_args()
+
+here = os.path.dirname(os.path.abspath(__file__))
+os.makedirs(a.out, exist_ok=True)
+t0 = time.time()
+
+if a.mode == 'pretrained':
+    model = os.path.join(here, 'DNNmodel', 'model_%d.ckpt' % a.K)
+    train_time = 0.0
+else:
+    tg = time.time()
+    Xtr, Ytr, _ = wf.generate_Gaussian_fast(a.K, a.num_train, seed=a.train_seed)   # deterministic given train_seed
+    print('training data generated in %.1f s' % (time.time() - tg))
+    df.tf.reset_default_graph()
+    df.tf.set_random_seed(a.seed)
+    np.random.seed(a.seed)
+    model = os.path.abspath(os.path.join(a.out, 'model_K%d_seed%d_n%d_e%d.ckpt' % (a.K, a.seed, a.num_train, a.epochs)))
+    cwd = os.getcwd(); os.chdir(a.out)          # df.train writes MSETime_*.mat into cwd
+    ts = time.time()
+    df.train(Xtr, Ytr, model, training_epochs=a.epochs, batch_size=a.batch, LR=a.lr, traintestsplit=a.val_split,
+             n_hidden_1=a.hidden[0], n_hidden_2=a.hidden[1], n_hidden_3=a.hidden[2])
+    train_time = time.time() - ts
+    os.chdir(cwd)
+    del Xtr, Ytr
+
+# Test set: official loop implementation, so the WMMSE CPU time is the paper's "WMMSE (Python)" column
+X, Y, wmmsetime = wf.generate_Gaussian(a.K, a.num_test, seed=a.test_seed)
+pred_file = os.path.join(a.out, 'Prediction_K%d_%s_seed%d' % (a.K, a.mode, a.seed))
+dnntime = df.test(X, model, pred_file, a.K * a.K, a.K, n_hidden_1=a.hidden[0], n_hidden_2=a.hidden[1],
+                  n_hidden_3=a.hidden[2], binary=1)
+H = np.reshape(X, (a.K, a.K, X.shape[1]), order="F")
+NNVbb = sio.loadmat(pred_file)['pred']
+r = wf.perf_eval(H, Y, NNVbb, a.K, plot=False)
+print('wmmse time: %0.3f s, dnn time: %0.3f s, time speed up: %0.1f X' % (wmmsetime, dnntime, wmmsetime / dnntime))
+
+row = dict(mode=a.mode, K=a.K, seed=a.seed if a.mode == 'train' else '', train_seed=a.train_seed if a.mode == 'train' else '',
+           test_seed=a.test_seed, num_train=a.num_train if a.mode == 'train' else 'unknown', num_test=a.num_test,
+           epochs=a.epochs if a.mode == 'train' else '', hidden='-'.join(map(str, a.hidden)),
+           wmmse_sumrate=round(r['wmmse'], 4), dnn_sumrate=round(r['dnn'], 4), dnn_pct_of_wmmse=round(r['ratio'], 3),
+           maxpower_pct=round(r['maxp_ratio'], 3), random_pct=round(r['rand_ratio'], 3),
+           dnn_cpu_s=round(dnntime, 4), wmmse_py_cpu_s=round(wmmsetime, 3), train_s=round(train_time, 1),
+           wall_s=round(time.time() - t0, 1))
+new = not os.path.exists(a.csv)
+with open(a.csv, 'a', newline='') as f:
+    w = csv.DictWriter(f, fieldnames=list(row))
+    if new:
+        w.writeheader()
+    w.writerow(row)
+print(row)
