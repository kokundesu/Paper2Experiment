+
+# [repro patch] Batched (vectorised over samples) version of generate_Gaussian + WMMSE_sum_rate.
+# Same RNG stream, same per-sample update rule (the b-update only depends on w, f of the previous
+# iteration, so it is a Jacobi step) and the same per-sample stopping rule (100 iterations or
+# objective increase <= 1e-3). Only used to make 1e6-sample data generation affordable on CPU.
+def WMMSE_sum_rate_batch(H, Pmax=1, var_noise=1, max_iter=100, tol=1e-3):
+    # H: (N, K, K) channel magnitudes, H[n, i, j] = |h_ij| as in WMMSE_sum_rate
+    N, K, _ = H.shape
+    H2 = np.square(H)
+    Hd = np.diagonal(H, axis1=1, axis2=2)                       # (N, K)
+    b = np.sqrt(Pmax) * np.ones((N, K))
+    def fw(b):
+        f = Hd * b / (np.einsum('nij,nj->ni', H2, np.square(b)) + var_noise)
+        w = 1 / (1 - f * b * Hd)
+        return f, w
+    f, w = fw(b)
+    vnew = np.log2(w).sum(1)
+    active = np.ones(N, dtype=bool)
+    for it in range(max_iter):
+        if not active.any():
+            break
+        vold = vnew.copy()
+        btmp = w * f * Hd / np.einsum('nk,nki->ni', w * np.square(f), H2)
+        bnew = np.minimum(btmp, np.sqrt(Pmax)) + np.maximum(btmp, 0) - btmp
+        b = np.where(active[:, None], bnew, b)
+        fn, wn = fw(b)
+        f = np.where(active[:, None], fn, f)
+        w = np.where(active[:, None], wn, w)
+        vnew = np.where(active, np.log2(w).sum(1), vnew)
+        active = active & ~(vnew - vold <= tol)
+    return np.square(b)
+
+def generate_Gaussian_fast(K, num_H, Pmax=1, seed=2017, chunk=10000):
+    print('Generate Data (batched) ... (seed = %d)' % seed)
+    np.random.seed(seed)
+    # X is stored sample-major in float32 (the network is fed float32 anyway) and returned as the
+    # (K^2, num_H) view the official code expects; 1e6 x 900 float64 (7.2 GB) plus the copy made in df.train would exhaust 16 GB RAM.
+    Xt = np.zeros((num_H, K ** 2), dtype=np.float32)
+    Y = np.zeros((K, num_H))
+    total_time = 0.0
+    for s in range(0, num_H, chunk):
+        n = min(chunk, num_H - s)
+        R = np.random.randn(n, 2, K, K)                         # same draw order as the loop version
+        H = np.abs(1 / np.sqrt(2) * (R[:, 0] + 1j * R[:, 1]))
+        Xt[s:s + n] = H.transpose(0, 2, 1).reshape(n, K ** 2)   # column-major flatten, as reshape(order="F")
+        t = time.time()
+        Y[:, s:s + n] = WMMSE_sum_rate_batch(H, Pmax).T
+        total_time += time.time() - t
+    return Xt.T, Y, total_time
