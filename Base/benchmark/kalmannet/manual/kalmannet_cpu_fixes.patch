index 2f0e88d..8469db2 100644
--- a/Simulations/Lorenz_Atractor/parameters.py
+++ b/Simulations/Lorenz_Atractor/parameters.py
@@ -148,8 +148,16 @@ def h(x, jacobian=False):
     else:
         return y
 
-def h_nonlinear(x):
-    return toSpherical(x)
+def h_nonlinear(x, jacobian=False):
+    # [p2e] the batched EKF calls getJacobian(x, h) -> h(x, jacobian=True); upstream h_nonlinear
+    # did not accept the flag (TypeError). Per-sample Jacobian via autograd on the batch sum
+    # (samples are independent, so d sum_b y_b / d x_b = dy_b/dx_b).
+    y = toSpherical(x)
+    if jacobian:
+        J = autograd.functional.jacobian(lambda z: toSpherical(z).sum(0), x)  # [n,1,B,m,1]
+        J = J.squeeze(-1).squeeze(1).permute(1, 0, 2)  # [B,n,m]
+        return y, J
+    return y
 
 def hRotate(x, jacobian=False):
     H = H_Rotate.to(x.device).reshape((1, n, n)).repeat(x.shape[0], 1, 1)# [batch_size, n, n] rotated matrix
